# Copy to .env.local for local development, and add the same variables in
# Netlify > Site configuration > Environment variables for production.
# Never commit the real keys.

# Assistant provider: set ONE of these. NVIDIA is used if both are set.
# Free NVIDIA key: https://build.nvidia.com (sign in, open a model, "Get API Key").
# Model list changes over time; tested working Nov 2026: nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Public URL of the deployed site, used for Open Graph tags, the sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
